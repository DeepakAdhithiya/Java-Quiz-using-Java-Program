import java.util.Scanner;
import java.util.concurrent.*;

public class RealTimeQuizGame {

    static Scanner sc = new Scanner(System.in);

    static String[] questions = {
        "Which keyword is used to create a class in Java?",
        "Which statement is used to make a decision in Java?",
        "Which loop executes at least once?",
        "Which keyword returns a value from a method?",
        "What is the first index of a Java array?",
        "Which OOP concept hides internal details?",
        "Which keyword is used for inheritance?",
        "Which block is used to handle an exception?",
        "Which method finds the length of a String?",
        "Which access modifier gives the widest access?"
    };

    static String[][] options = {
        {"1. class", "2. create", "3. object", "4. new"},
        {"1. if", "2. for", "3. switch", "4. break"},
        {"1. for", "2. while", "3. do-while", "4. if"},
        {"1. return", "2. break", "3. void", "4. get"},
        {"1. 0", "2. 1", "3. -1", "4. 2"},
        {"1. Inheritance", "2. Abstraction", "3. Polymorphism", "4. Encapsulation"},
        {"1. implements", "2. extends", "3. inherits", "4. super"},
        {"1. try", "2. catch", "3. finally", "4. throw"},
        {"1. size()", "2. count()", "3. length()", "4. getLength()"},
        {"1. private", "2. protected", "3. default", "4. public"}
    };

    static int[] answers = {1, 1, 3, 1, 1, 2, 2, 1, 3, 4};

    static void displayQuestion(int i) {
        System.out.println("\nQuestion " + (i + 1) + ":");
        System.out.println(questions[i]);

        for (String option : options[i]) {
            System.out.println(option);
        }

        System.out.print("Enter your answer: ");
    }

    public static void main(String[] args) {

        int score = 0;

        ExecutorService service =
                Executors.newSingleThreadExecutor();

        System.out.println("================================");
        System.out.println("       REAL-TIME JAVA QUIZ");
        System.out.println("================================");
        System.out.println("You have 8 seconds for each question.");
        System.out.print("Enter your name:");
        String name=sc.nextLine();

        for (int i = 0; i < questions.length; i++) {

            displayQuestion(i);

            Future<String> input =
                    service.submit(() -> sc.nextLine());

            try {
                String value = input.get(8, TimeUnit.SECONDS);
                int answer = Integer.parseInt(value);

                if (answer < 1 || answer > 4) {
                    System.out.println("Invalid option! Choose 1 to 4.");
                    System.out.println("Correct answer: "
                            + options[i][answers[i] - 1]);
                }

                else if (answer == answers[i]) {
                    System.out.println("Correct!");
                    score++;
                }

                else {
                    System.out.println("Wrong answer!");
                    System.out.println("Correct answer: "
                            + options[i][answers[i] - 1]);
                }

            } catch (TimeoutException e) {

                System.out.println("\nTime's up!");
                System.out.println("Correct answer: "
                        + options[i][answers[i] - 1]);
                input.cancel(true);

            } catch (NumberFormatException e) {

                System.out.println("Invalid input!");
                System.out.println("Correct answer: "
                        + options[i][answers[i] - 1]);

            } catch (InterruptedException e) {

                System.out.println("Quiz interrupted.");
                break;

            } catch (ExecutionException e) {

                System.out.println("Input error.");
            }
        }

        service.shutdownNow();

        System.out.println("\n================================");
        System.out.println("           QUIZ RESULT");
        System.out.println("================================");
        System.out.println("Name:"+name);
        System.out.println("Your Score: " + score + "/10");


        if (score >= 8)
            System.out.println("Excellent!");
        else if (score >= 5)
            System.out.println("Good job!");
        else
            System.out.println("Keep practicing!");

        sc.close();
    }
} 
